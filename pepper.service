[Unit]
Description=Pepper.pl Discord Bot
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/pepper-discord-bot
ExecStart=/root/.local/bin/uv run bot.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
MemoryMax=512M

[Install]
WantedBy=multi-user.target
